{
  "task": "openeval.tasks.qa.QATask",
  "dataset": "openeval.datasets.jsonl.JSONLinesDataset",
  "adapter": "openeval.adapters.echo.EchoAdapter",
  "task_kwargs": {"instruction": "Answer the question concisely."},
  "dataset_kwargs": {"path": "examples/qa_toy.jsonl"},
  "metrics": [
    {"name": "openeval.metrics.accuracy.ExactMatch"},
    {"name": "openeval.metrics.calibration.CalibrationError"},
    {"name": "openeval.metrics.calibration.ConfidenceIntervals"},
    {"name": "openeval.metrics.calibration.DiversityMetrics"}
  ],
  "output": "results.json"
}
